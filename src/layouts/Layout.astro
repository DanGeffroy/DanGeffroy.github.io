---
import BaseHead from "../components/BaseHead.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead />
  </head>

  <body
    class="min-h-screen bg-dark font-sans text-zinc-300 antialiased selection:bg-accent/30 selection:text-white"
  >
    <!-- Scanline overlay -->
    <div class="scanline-overlay" aria-hidden="true"></div>
    <slot />
    <style is:global>
      * {
        box-sizing: border-box;
      }

      html {
        scroll-behavior: smooth;
      }

      /* === SCANLINE OVERLAY === */
      .scanline-overlay {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 9999;
        background: repeating-linear-gradient(
          0deg,
          transparent,
          transparent 2px,
          rgba(255, 63, 0, 0.015) 2px,
          rgba(255, 63, 0, 0.015) 4px
        );
      }

      /* === BOOT-UP ANIMATION === */
      @keyframes bootUp {
        0% {
          opacity: 0;
          transform: translateY(8px);
          filter: blur(2px);
        }
        60% {
          opacity: 1;
          filter: blur(0);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
          filter: blur(0);
        }
      }

      @keyframes glitchIn {
        0% {
          opacity: 0;
          transform: translateX(-4px) skewX(-2deg);
        }
        20% {
          opacity: 1;
          transform: translateX(2px) skewX(1deg);
        }
        40% {
          transform: translateX(-1px) skewX(0deg);
        }
        100% {
          opacity: 1;
          transform: translateX(0) skewX(0);
        }
      }

      @keyframes scanReveal {
        0% {
          clip-path: inset(0 0 100% 0);
        }
        100% {
          clip-path: inset(0 0 0 0);
        }
      }

      .fade-in {
        animation: bootUp 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .fade-in-delay-1 {
        animation: bootUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.15s both;
      }

      .fade-in-delay-2 {
        animation: bootUp 0.5s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
      }

      /* === SECTION TITLE STYLE === */
      .section-title {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: #ffffff;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }

      .section-title::before {
        content: "//";
        color: rgba(255, 63, 0, 0.9);
        font-family: "Inter", system-ui, sans-serif;
      }

      .section-title::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, rgba(255, 63, 0, 0.3), transparent);
      }

      /* === HUD DECORATIVE BRACKETS === */
      .hud-frame {
        position: relative;
        border: 1px solid rgba(255, 63, 0, 0.15);
      }

      .hud-frame::before,
      .hud-frame::after {
        content: "";
        position: absolute;
        width: 12px;
        height: 12px;
        border-color: #FF3F00;
        border-style: solid;
      }

      .hud-frame::before {
        top: -1px;
        left: -1px;
        border-width: 2px 0 0 2px;
      }

      .hud-frame::after {
        bottom: -1px;
        right: -1px;
        border-width: 0 2px 2px 0;
      }

      /* === GLITCH TEXT EFFECT === */
      .glitch-text {
        position: relative;
      }

      .glitch-text::before,
      .glitch-text::after {
        content: attr(data-text);
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }

      .glitch-text::before {
        color: #0ff;
        animation: glitchShift 3s infinite;
        clip-path: polygon(0 0, 100% 0, 100% 35%, 0 35%);
      }

      .glitch-text::after {
        color: #f00;
        animation: glitchShift 3s infinite reverse;
        clip-path: polygon(0 65%, 100% 65%, 100% 100%, 0 100%);
      }

      @keyframes glitchShift {
        0%, 100% { transform: translate(0); }
        20% { transform: translate(-2px, 1px); }
        40% { transform: translate(2px, -1px); }
        60% { transform: translate(-1px, 0); }
        80% { transform: translate(1px, 1px); }
      }

      /* === TECHNICAL REF LABELS === */
      .tech-ref {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 0.55rem;
        color: #71717a;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }

      /* === BEVELED CORNER CLIP === */
      .bevel-clip {
        clip-path: polygon(
          12px 0%, 100% 0%, 100% calc(100% - 12px),
          calc(100% - 12px) 100%, 0% 100%, 0% 12px
        );
      }
    </style>
  </body>
</html>
