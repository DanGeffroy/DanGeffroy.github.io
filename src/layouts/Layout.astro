---
import BaseHead from "../components/BaseHead.astro";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/800.css";
import "@fontsource/inter/900.css";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead />
  </head>

  <body
    class="min-h-screen bg-cream font-sans text-ink antialiased selection:bg-brutal-pink/40 selection:text-ink"
  >
    <slot />
    <style is:global>
      /* === NEO-BRUTALIST BASE === */
      body {
        background-color: #FFF8E7;
        background-image: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%231A1A2E' fill-opacity='0.03'%3E%3Ccircle cx='20' cy='20' r='1'/%3E%3C/g%3E%3C/svg%3E");
      }

      /* === SLIDE-IN ANIMATION === */
      @keyframes slideUp {
        from {
          opacity: 0;
          transform: translateY(24px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .fade-in {
        animation: slideUp 0.5s ease-out;
      }

      .fade-in-delay-1 {
        animation: slideUp 0.5s ease-out 0.15s both;
      }

      .fade-in-delay-2 {
        animation: slideUp 0.5s ease-out 0.3s both;
      }

      /* === SECTION TITLE STYLE === */
      .section-title {
        font-family: "Inter", system-ui, sans-serif;
        font-size: 1.75rem;
        font-weight: 900;
        letter-spacing: -0.02em;
        text-transform: uppercase;
        color: #1A1A2E;
        display: inline-block;
        margin-bottom: 1.5rem;
        position: relative;
      }

      .section-title::after {
        content: "";
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 100%;
        height: 4px;
        background: #1A1A2E;
      }

      /* === NEO-BRUTAL CARD BASE === */
      .brutal-card {
        background: #ffffff;
        border: 3px solid #1A1A2E;
        box-shadow: 4px 4px 0 #1A1A2E;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .brutal-card:hover {
        transform: translate(-2px, -2px);
        box-shadow: 6px 6px 0 #1A1A2E;
      }

      /* === CARD SLIDE IN === */
      @keyframes cardSlideIn {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      /* === ACCESSIBILITY === */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      :focus-visible {
        outline: 3px solid #FF6B9D;
        outline-offset: 3px;
      }

      /* === SCROLL-TRIGGERED ANIMATIONS === */
      .brutal-card {
        opacity: 0;
        transform: translateY(20px);
      }

      .brutal-card.in-view {
        opacity: 1;
        transform: translateY(0);
        transition: opacity 0.4s ease, transform 0.4s ease;
      }

    </style>

    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.brutal-card').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
