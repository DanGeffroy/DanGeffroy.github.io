---

<section class="fade-in-delay-2">
  <h2 class="section-title">
    Contact
  </h2>

  <div class="contact-grid">
    {
      contact.map((template, i) => (
        <a
          href={template.link}
          title={template.type}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-card group"
          style={`animation-delay: ${0.3 + i * 0.06}s`}
        >
          <div class="contact-icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="currentColor"
              width="18"
              height="18"
            >
              <path d={icons[template.type]} />
            </svg>
          </div>
          <div class="min-w-0">
            <span class="font-display text-[10px] font-normal tracking-widest text-zinc-600 uppercase group-hover:text-accent transition-colors duration-75">
              {template.type}
            </span>
            <span class="mt-0.5 block min-w-0 truncate font-mono text-xs text-zinc-400 group-hover:text-white">
              {template.title}
              <span class="ml-1 inline-block text-zinc-700 transition-transform duration-75 group-hover:translate-x-1 group-hover:text-accent">
                ↗
              </span>
            </span>
          </div>
        </a>
      ))
    }
  </div>

  <!-- Footer system bar -->
  <div class="mt-12 pt-4 border-t border-zinc-900 flex justify-between items-center">
    <span class="tech-ref">SYS.END // ALL_MODULES_LOADED</span>
    <span class="tech-ref">© {new Date().getFullYear()}</span>
  </div>
</section>

<style>
  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .contact-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    border: 1px solid rgba(255, 63, 0, 0.08);
    padding: 0.75rem 1rem;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: border-color 0.05s ease, box-shadow 0.05s ease;
    text-decoration: none;
    animation: cardSlideIn 0.5s ease-out both;
  }

  .contact-card:hover {
    border-color: rgba(255, 63, 0, 0.4);
    box-shadow: 0 0 12px rgba(255, 63, 0, 0.06);
  }

  .contact-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border: 1px solid rgba(255, 63, 0, 0.15);
    color: rgba(255, 63, 0, 0.5);
    transition: all 0.05s ease;
  }

  .contact-card:hover .contact-icon {
    border-color: rgba(255, 63, 0, 0.5);
    color: #FF3F00;
    background: rgba(255, 63, 0, 0.05);
  }

  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

