---
import { contact } from "../../data/contact.json";
---

<section class="fade-in-delay-2">
  <h2
    class="mb-6 text-xs font-semibold uppercase tracking-wider text-zinc-500"
  >
    Contact
  </h2>

  <div class="space-y-1">
    {
      contact.map((template) => (
        <a
          href={template.link}
          title={template.type}
          target="_blank"
          rel="noopener noreferrer"
          class="group -mx-3 flex flex-col gap-1 rounded-lg px-3 py-3 transition-colors hover:bg-dark-100 md:flex-row md:items-baseline md:gap-6"
        >
          <span class="shrink-0 text-xs font-medium text-zinc-500 md:w-24">
            {template.type}
          </span>
          <span class="min-w-0 truncate text-sm text-zinc-300 group-hover:text-white">
            {template.title}
            <span class="ml-1 inline-block text-zinc-600 transition-transform group-hover:translate-x-0.5">
              ↗
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>

