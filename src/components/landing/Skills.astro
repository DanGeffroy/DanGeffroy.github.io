---
interface SkillCategory {
  title: string;
  icon: string;
  skills: string[];
}

const categories: SkillCategory[] = [
  {
    title: "Frontend",
    icon: "M12 18l-6-6 1.41-1.41L12 15.17l4.59-4.58L18 12z",
    skills: ["Angular", "Svelte", "Astro", "Next.js", "TypeScript", "Tailwind"],
  },
  {
    title: "Backend",
    icon: "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H4V5h16v14z",
    skills: ["Java", "Spring Boot", "Node", "Deno"],
  },
  {
    title: "Databases",
    icon: "M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.72 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2V9.77C7.61 10.55 9.72 11 12 11s4.39-.45 6-1.23V12z",
    skills: ["MongoDB", "MariaDB", "SQL"],
  },
  {
    title: "Tools",
    icon: "M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z",
    skills: ["Copilot", "VS Code", "GitHub", "GitLab"],
  },
];
---

<section class="fade-in-delay-1">
  <h2 class="flex items-center gap-2 mb-6 text-xs font-bold tracking-[0.05em] uppercase bg-gradient-to-br from-violet-400 via-purple-400 to-fuchsia-400 bg-clip-text text-transparent">
    <span class="inline-block w-6 h-0.5 bg-gradient-to-r from-violet-500 to-purple-500 rounded-[2px] shrink-0" aria-hidden="true"></span>
    Skills
  </h2>

  <div class="grid grid-cols-2 gap-3 max-[480px]:grid-cols-1">
    {
      categories.map((category, i) => (
        <div
          class="group relative border border-violet-500/[0.08] rounded-xl p-4 bg-zinc-900/25 backdrop-blur-md transition-all duration-300 overflow-hidden animate-[cardSlideIn_0.5s_ease-out_both] hover:border-violet-500/30 hover:bg-zinc-900/40 hover:shadow-[0_4px_24px_rgba(139,92,246,0.08)] hover:-translate-y-0.5"
          style={`animation-delay: ${0.1 + i * 0.08}s`}
        >
          <div class="absolute top-0 left-0 w-[3px] h-0 bg-gradient-to-b from-violet-500 to-purple-500 rounded-[3px] transition-[height] duration-300 group-hover:h-full" />
          <div class="flex items-center gap-2 mb-3">
            <div class="flex items-center justify-center shrink-0 w-8 h-8 rounded-lg bg-violet-500/[0.08] text-violet-400/70 transition-all duration-300 group-hover:bg-violet-500/15 group-hover:text-violet-400" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="18"
                height="18"
              >
                <path d={category.icon} />
              </svg>
            </div>
            <h3 class="text-sm font-semibold text-zinc-100">{category.title}</h3>
          </div>
          <div class="flex flex-wrap gap-1.5">
            {category.skills.map((skill) => (
              <span class="inline-flex items-center px-2.5 py-1 text-xs font-medium text-violet-400/90 bg-violet-500/10 border border-violet-500/15 rounded-full transition-all duration-200 whitespace-nowrap group-hover:bg-violet-500/15 group-hover:border-violet-500/25">{skill}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
