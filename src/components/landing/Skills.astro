---
interface SkillCategory {
  title: string;
  icon: string;
  skills: string[];
  color: string;
}

const categories: SkillCategory[] = [
  {
    title: "Frontend",
    icon: "M12 18l-6-6 1.41-1.41L12 15.17l4.59-4.58L18 12z",
    skills: ["Angular", "Svelte", "Astro", "Next.js", "TypeScript", "Tailwind"],
    color: "#FF6B9D",
  },
  {
    title: "Backend",
    icon: "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H4V5h16v14z",
    skills: ["Java", "Spring Boot", "Node", "Deno"],
    color: "#4DEEEA",
  },
  {
    title: "Databases",
    icon: "M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.72 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2V9.77C7.61 10.55 9.72 11 12 11s4.39-.45 6-1.23V12z",
    skills: ["MongoDB", "MariaDB", "SQL"],
    color: "#FFE74C",
  },
  {
    title: "Tools",
    icon: "M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z",
    skills: ["Copilot", "VS Code", "GitHub", "GitLab"],
    color: "#06D6A0",
  },
];
---

<section class="fade-in-delay-1">
  <h2 class="section-title">
    Skills
  </h2>

  <div class="grid grid-cols-2 gap-4 max-[480px]:grid-cols-1">
    {
      categories.map((category, i) => (
        <div
          class="skill-card brutal-card"
          style={`animation-delay: ${0.1 + i * 0.08}s; --card-color: ${category.color};`}
        >
          <div class="card-header" style={`background: ${category.color};`}>
            <div class="skill-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="20"
                height="20"
              >
                <path d={category.icon} />
              </svg>
            </div>
            <h3 class="text-sm font-black uppercase tracking-wide text-ink">{category.title}</h3>
          </div>
          <div class="card-body">
            <div class="flex flex-wrap gap-2">
              {category.skills.map((skill) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<style>
  .skill-card {
    overflow: hidden;
    animation: cardSlideIn 0.5s ease-out both;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border-bottom: 3px solid #1A1A2E;
  }

  .skill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    color: #1A1A2E;
  }

  .card-body {
    padding: 1rem;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #1A1A2E;
    background: #FFF8E7;
    border: 2px solid #1A1A2E;
    box-shadow: 2px 2px 0 #1A1A2E;
    white-space: nowrap;
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }

  .skill-tag:hover {
    transform: translate(-1px, -1px);
    box-shadow: 3px 3px 0 #1A1A2E;
  }
</style>
