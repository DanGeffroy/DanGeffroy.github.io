---
interface SkillCategory {
  title: string;
  icon: string;
  skills: string[];
}

const categories: SkillCategory[] = [
  {
    title: "Frontend",
    icon: "M12 18l-6-6 1.41-1.41L12 15.17l4.59-4.58L18 12z",
    skills: ["Angular", "Svelte", "Astro", "Next.js", "TypeScript", "Tailwind"],
  },
  {
    title: "Backend",
    icon: "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H4V5h16v14z",
    skills: ["Java", "Spring Boot", "Node", "Deno"],
  },
  {
    title: "Databases",
    icon: "M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.72 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2V9.77C7.61 10.55 9.72 11 12 11s4.39-.45 6-1.23V12z",
    skills: ["MongoDB", "MariaDB", "SQL"],
  },
  {
    title: "Tools",
    icon: "M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z",
    skills: ["Copilot", "VS Code", "GitHub", "GitLab"],
  },
];
---

<section id="skills" class="fade-in-delay-2 py-16 md:py-24">
  <!-- Section label -->
  <div class="flex items-center gap-4 mb-10">
    <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f5f5f5]">
      Skills
    </h2>
    <div class="flex-1 h-px bg-[#262626]"></div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {
      categories.map((category, i) => (
        <div
          class="group rounded-2xl border border-[#262626] bg-gradient-to-br from-zinc-800/50 to-zinc-900/50 p-6 transition-all duration-300 hover:border-[#525252]"
          style={`animation-delay: ${0.1 + i * 0.08}s`}
        >
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#0a0a0a]/60 text-[#a3a3a3] group-hover:text-accent transition-colors duration-300">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="18"
                height="18"
              >
                <path d={category.icon} />
              </svg>
            </div>
            <h3 class="text-sm font-bold text-[#f5f5f5] uppercase tracking-wider">
              {category.title}
            </h3>
          </div>
          <div class="flex flex-wrap gap-2">
            {category.skills.map((skill) => (
              <span class="inline-flex items-center px-3 py-1.5 text-[11px] font-medium text-[#a3a3a3] bg-[#0a0a0a]/40 rounded-full border border-white/[0.06] transition-all duration-300 hover:text-accent hover:border-accent/30">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
