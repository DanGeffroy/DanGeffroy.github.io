---
interface SkillCategory {
  title: string;
  icon: string;
  skills: string[];
}

const categories: SkillCategory[] = [
  {
    title: "Frontend",
    icon: "M12 18l-6-6 1.41-1.41L12 15.17l4.59-4.58L18 12z",
    skills: ["Angular", "Svelte", "Astro", "Next.js", "TypeScript", "Tailwind"],
  },
  {
    title: "Backend",
    icon: "M20 3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H4V5h16v14z",
    skills: ["Java", "Spring Boot", "Node", "Deno"],
  },
  {
    title: "Databases",
    icon: "M12 3C7.58 3 4 4.79 4 7v10c0 2.21 3.58 4 8 4s8-1.79 8-4V7c0-2.21-3.58-4-8-4zm0 2c3.87 0 6 1.5 6 2s-2.13 2-6 2-6-1.5-6-2 2.13-2 6-2zm6 12c0 .5-2.13 2-6 2s-6-1.5-6-2v-2.23c1.61.78 3.72 1.23 6 1.23s4.39-.45 6-1.23V17zm0-5c0 .5-2.13 2-6 2s-6-1.5-6-2V9.77C7.61 10.55 9.72 11 12 11s4.39-.45 6-1.23V12z",
    skills: ["MongoDB", "MariaDB", "SQL"],
  },
  {
    title: "Tools",
    icon: "M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z",
    skills: ["Copilot", "VS Code", "GitHub", "GitLab"],
  },
];
---

<section class="fade-in-delay-1">
  <h2 class="section-title">
    <span class="title-accent" aria-hidden="true"></span>
    Skills
  </h2>

  <div class="skills-grid">
    {
      categories.map((category, i) => (
        <div
          class="skill-card"
          style={`animation-delay: ${0.1 + i * 0.08}s`}
        >
          <div class="card-accent" />
          <div class="card-header">
            <div class="category-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="18"
                height="18"
              >
                <path d={category.icon} />
              </svg>
            </div>
            <h3 class="category-title">{category.title}</h3>
          </div>
          <div class="chips">
            {category.skills.map((skill) => (
              <span class="chip">{skill}</span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }

  @media (max-width: 480px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  .skill-card {
    position: relative;
    border: 1px solid rgba(139, 92, 246, 0.08);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    background: rgba(24, 24, 27, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: all 0.3s ease;
    overflow: hidden;
    animation: cardSlideIn 0.5s ease-out both;
  }

  .skill-card:hover {
    border-color: rgba(139, 92, 246, 0.3);
    background: rgba(30, 30, 34, 0.4);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.08);
    transform: translateY(-2px);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: linear-gradient(180deg, #8b5cf6, #a855f7);
    border-radius: 3px;
    transition: height 0.3s ease;
  }

  .skill-card:hover .card-accent {
    height: 100%;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .category-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: rgba(139, 92, 246, 0.08);
    color: rgba(167, 139, 250, 0.7);
    transition: all 0.3s ease;
  }

  .skill-card:hover .category-icon {
    background: rgba(139, 92, 246, 0.15);
    color: rgba(167, 139, 250, 1);
  }

  .category-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: #e4e4e7;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(167, 139, 250, 0.9);
    background: rgba(139, 92, 246, 0.1);
    border: 1px solid rgba(139, 92, 246, 0.15);
    border-radius: 9999px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .skill-card:hover .chip {
    background: rgba(139, 92, 246, 0.15);
    border-color: rgba(139, 92, 246, 0.25);
  }

  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
