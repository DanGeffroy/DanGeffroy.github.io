---
import { projects } from "../../data/projects.json";
---

<section class="fade-in-delay-1">
  <h2 class="section-title">Projects</h2>

  <div class="grid grid-cols-2 gap-4 max-[480px]:grid-cols-1">
    {
      projects.map((project, i) => {
        const Tag = project.url && !project.isInternal ? "a" : "div";
        const linkProps =
          project.url && !project.isInternal
            ? { href: project.url, target: "_blank", rel: "noopener noreferrer" }
            : {};
        const rotations = [-3.5, 2.5, -2, 4, -2.5, 3, -1.5, 3.5];
        const offsets = [
          { x: 0, y: 0 },
          { x: 8, y: -6 },
          { x: -6, y: 8 },
          { x: 10, y: 4 },
          { x: -8, y: -4 },
          { x: 6, y: 10 },
          { x: -4, y: -8 },
          { x: 10, y: -6 },
        ];
        const rot = rotations[i % rotations.length];
        const off = offsets[i % offsets.length];
        return (
          <Tag
            {...linkProps}
            class="browser-card fun-card flex flex-col overflow-hidden no-underline rounded-xl brutal-card group"
            style={`animation-delay: ${0.1 + i * 0.1}s; --rot: ${rot}deg; --tx: ${off.x}px; --ty: ${off.y}px;`}
          >
            <div
              class="flex items-center gap-3 px-3 py-2.5 border-b-[3px] border-ink"
              style={`background: ${project.color};`}
            >
              <div class="flex gap-[5px] shrink-0">
                <span class="w-2.5 h-2.5 rounded-full border-2 border-ink" style="background: #FF6B9D;" />
                <span class="w-2.5 h-2.5 rounded-full border-2 border-ink" style="background: #FFE74C;" />
                <span class="w-2.5 h-2.5 rounded-full border-2 border-ink" style="background: #06D6A0;" />
              </div>
              <span class="text-[0.65rem] font-bold text-ink bg-white/50 border-2 border-ink px-2 py-[0.15rem] flex-1 min-w-0 overflow-hidden text-ellipsis whitespace-nowrap">{project.fakeUrl}</span>
            </div>
            <div class="w-full aspect-video overflow-hidden border-b-[3px] border-ink">
              {project.image ? (
                <img
                  src={project.image}
                  alt={`${project.title} screenshot`}
                  class="w-full h-full object-cover object-top block"
                  loading="lazy"
                />
              ) : (
                <div
                  class="w-full h-full flex items-center justify-center"
                  style={`background: ${project.color}22;`}
                >
                  <span class="text-[0.7rem] font-bold text-ink opacity-40 uppercase tracking-[0.08em]">Private / Internal</span>
                </div>
              )}
            </div>
            <div class="p-4 px-5 pb-5">
              <p class="text-sm font-black uppercase tracking-tight text-ink">
                {project.title}
                {project.url && !project.isInternal && (
                  <span class="ml-1 inline-block transition-transform duration-150 group-hover:translate-x-1">
                    ↗
                  </span>
                )}
                {project.isInternal && (
                  <span class="ml-2 inline-block rounded border border-ink/20 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-ink/40">
                    Internal
                  </span>
                )}
              </p>
              <p class="mt-1.5 text-xs leading-relaxed text-ink/60">
                {project.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="project-tag inline-flex items-center px-2.5 py-[0.2rem] text-[0.7rem] font-bold text-ink bg-cream border-2 border-ink shadow-brutal-sm whitespace-nowrap transition-[transform,box-shadow] duration-100 hover:-translate-x-px hover:-translate-y-px hover:shadow-[3px_3px_0_#1a1a2e]">{tag}</span>
                ))}
              </div>
            </div>
          </Tag>
        );
      })
    }
  </div>
</section>

<style>
  .browser-card {
    animation: cardSlideIn 0.5s ease-out both;
  }

  @media (min-width: 1024px) {
    .fun-card {
      animation: funCardSlideIn 0.5s ease-out both;
    }

    .fun-card.animated {
      animation: none;
      opacity: 1;
      transform: rotate(var(--rot)) translate(var(--tx), var(--ty));
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .fun-card.animated:hover {
      transform: rotate(calc(var(--rot) * 1.4)) translate(calc(var(--tx) * 1.3), calc(var(--ty) * 1.3)) scale(1.03);
      z-index: 10;
    }
  }

  @keyframes funCardSlideIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: rotate(var(--rot)) translate(var(--tx), var(--ty));
    }
  }
</style>

<script>
  document.querySelectorAll('.fun-card').forEach((card) => {
    card.addEventListener('animationend', () => {
      card.classList.add('animated');
    });
  });
</script>
