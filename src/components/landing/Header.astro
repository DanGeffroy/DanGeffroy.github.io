---
import { totalExp } from "../../data/details.json";
import TypeWriter from "./TypeWriter.svelte";
---

<section class="fade-in pb-8 lg:grid lg:grid-cols-5 lg:gap-8 lg:items-center">
  <div class="lg:col-span-2">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8 lg:flex-col lg:items-start">
      <div class="relative shrink-0">
        <img
          class="block w-24 h-24 border-[3px] border-ink shadow-brutal md:w-[120px] md:h-[120px]"
          src="/avatar.jpg"
          alt="Portrait photo of Dan Geffroy"
        />
      </div>
      <div>
        <h1 class="text-3xl font-black uppercase tracking-tight text-ink md:text-4xl">
          Dan <span class="text-brutal-pink font-black"><TypeWriter client:load /></span><br />
          GEFFROY
        </h1>
        <p class="mt-2 text-base font-bold uppercase tracking-wide text-ink/70">Software Engineer in Nantes / France</p>
        <a
          class="brutal-link mt-2 inline-block text-[0.8rem] font-bold text-ink no-underline border-b-[3px] border-ink transition-colors duration-150"
          href="https://dangeffroy.github.io"
          >dangeffroy.github.io ↗</a
        >
        <div class="mt-2">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-[3px] text-[0.7rem] font-extrabold uppercase tracking-[0.08em] bg-brutal-green border-2 border-ink shadow-brutal-sm text-ink">
            <span class="status-dot w-2 h-2 bg-ink rounded-full"></span>
            Currently employed
          </span>
        </div>
      </div>
    </div>
  </div>

  <div class="about-card brutal-card mt-10 lg:mt-0 lg:col-span-3 bg-brutal-yellow/30 p-6">
    <h2 class="section-title">
      About
    </h2>
    <div class="space-y-3 text-sm leading-relaxed text-ink/80">
      <p>
        For the past {totalExp} years, I have developed many types of front-ends
        from educational platforms to insurance websites.
      </p>
      <p>
        I Specialize in front-end development, but I also have experience with
        back-end development, DevOps and cloud infrastructure.
      </p>
      <p>
        I am skilled in leading software projects and have the ability to manage,
        mentor, and hire software engineers.
      </p>
    </div>
  </div>
</section>

<style>
  .brutal-link:hover {
    color: #FF6B9D;
    border-color: #FF6B9D;
  }

  .status-dot {
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>
