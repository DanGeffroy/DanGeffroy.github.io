---
import { totalExp } from "../../data/details.json";
---

<section class="fade-in pb-16">
  <div class="flex items-center gap-5">
    <div class="shrink-0">
      <img
        class="h-16 w-16 rounded-full ring-2 ring-accent/30 md:h-20 md:w-20"
        src="/avatar.jpg"
        alt="Dan GEFFROY"
      />
    </div>
    <div>
      <h1 class="text-lg font-semibold text-white md:text-xl">
        Dan '<span class="gradient-text">adnnnnj</span>' GEFFROY
      </h1>
      <p class="text-sm text-zinc-400">Software Engineer in Nantes / France</p>
      <a
        class="mt-0.5 inline-block text-xs text-zinc-500 transition-colors hover:text-accent-light"
        href="https://dangeffroy.github.io"
        >dangeffroy.github.io</a
      >
    </div>
  </div>

  <div class="mt-12">
    <h2 class="mb-4 text-xs font-semibold uppercase tracking-wider text-zinc-500">
      About
    </h2>
    <div class="space-y-3 text-sm leading-relaxed text-zinc-400">
      <p>
        For the past {totalExp} years, I have developed many types of front-ends
        from educational platforms to insurance websites.
      </p>
      <p>
        I Specialize in front-end development, but I also have experience with
        back-end development, DevOps and cloud infrastructure.
      </p>
      <p>
        I am skilled in leading software projects and have the ability to manage,
        mentor, and hire software engineers.
      </p>
    </div>
  </div>
</section>

<style>
  .gradient-text {
    @apply bg-gradient-to-r from-violet-400 via-purple-400 to-fuchsia-400 bg-clip-text font-bold text-transparent;
  }

  .fade-in {
    animation: fadeIn 0.6s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
