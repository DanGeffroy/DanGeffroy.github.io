---
import { totalExp } from "../../data/details.json";
import TypeWriter from "./TypeWriter.svelte";
---

<section class="fade-in min-h-[85vh] flex flex-col justify-center pb-16 md:pb-24">
  <!-- Nav bar -->
  <nav class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-[#0a0a0a]/80 border-b border-white/[0.06]">
    <div class="mx-auto max-w-7xl px-6 md:px-12 py-4 flex items-center justify-between">
      <span class="text-sm font-semibold tracking-tight text-[#f5f5f5]">DG.</span>
      <div class="hidden md:flex items-center gap-8">
        <a href="#experience" class="text-xs text-[#a3a3a3] hover:text-accent transition-colors duration-300">Experience</a>
        <a href="#projects" class="text-xs text-[#a3a3a3] hover:text-accent transition-colors duration-300">Projects</a>
        <a href="#skills" class="text-xs text-[#a3a3a3] hover:text-accent transition-colors duration-300">Skills</a>
        <a href="#contact" class="text-xs text-[#a3a3a3] hover:text-accent transition-colors duration-300">Contact</a>
      </div>
      <a
        href="#contact"
        class="border border-white/20 px-4 py-1.5 text-xs text-[#f5f5f5] hover:border-accent hover:text-accent transition-all duration-300"
      >
        Get in touch
      </a>
    </div>
  </nav>

  <!-- Hero content -->
  <div class="pt-24 md:pt-32">
    <p class="text-sm md:text-base font-light text-[#a3a3a3] mb-4 md:mb-6 tracking-wide fade-in">
      Software Engineer — Nantes, France
    </p>

    <h1 class="text-5xl sm:text-7xl md:text-8xl lg:text-9xl font-black tracking-tighter leading-[0.9] text-[#f5f5f5] max-w-[70%] fade-in-delay-1">
      Dan<br />
      <span class="text-[#a3a3a3]">GEFFROY</span>
    </h1>

    <p class="mt-6 md:mt-8 max-w-md text-sm md:text-base font-light leading-relaxed text-[#737373] fade-in-delay-2">
      For the past {totalExp} years, crafting digital experiences — from
      insurance platforms to creative front-ends. Specializing in modern
      web technologies with a passion for clean, performant code.
    </p>

    <div class="mt-8 md:mt-10 flex flex-wrap items-center gap-4 fade-in-delay-2">
      <a
        href="#contact"
        class="inline-flex items-center gap-2 border border-[#f5f5f5]/30 px-6 py-3 text-sm text-[#f5f5f5] hover:border-accent hover:text-accent transition-all duration-300"
      >
        Contact me
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <span class="text-xs text-[#737373] font-light">
        aka '<TypeWriter client:load />'
      </span>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 hidden md:flex flex-col items-center gap-2 fade-in-delay-3">
    <span class="text-[10px] text-[#737373] uppercase tracking-[0.2em]">Scroll</span>
    <div class="w-px h-8 bg-gradient-to-b from-[#737373] to-transparent"></div>
  </div>
</section>
