---
import { totalExp } from "../../data/details.json";
import TypeWriter from "./TypeWriter.svelte";
---

<section class="fade-in pb-16">
  <div class="flex items-center gap-5">
    <div class="avatar-ring shrink-0">
      <img
        class="h-16 w-16 rounded-full md:h-20 md:w-20"
        src="/avatar.jpg"
        alt="Dan GEFFROY"
      />
    </div>
    <div>
      <h1 class="font-serif text-2xl font-semibold text-cream md:text-3xl">
        Dan '<span class="accent-text"><TypeWriter client:load /></span>' GEFFROY
      </h1>
      <p class="title-role text-sm text-cream-muted">Software Engineer in Nantes / France</p>
      <a
        class="mt-0.5 inline-block text-xs text-dark-300 transition-colors hover:text-accent-light"
        href="https://dangeffroy.github.io"
        >dangeffroy.github.io</a
      >
    </div>
  </div>

  <div class="about-card mt-12">
    <h2 class="section-label">
      About
    </h2>
    <div class="space-y-3 text-sm leading-relaxed text-cream-muted">
      <p>
        For the past {totalExp} years, I have developed many types of front-ends
        from educational platforms to insurance websites.
      </p>
      <p>
        I Specialize in front-end development, but I also have experience with
        back-end development, DevOps and cloud infrastructure.
      </p>
      <p>
        I am skilled in leading software projects and have the ability to manage,
        mentor, and hire software engineers.
      </p>
    </div>
  </div>
</section>

<style>
  .accent-text {
    color: #C8965A;
    font-weight: 700;
    font-family: "Cormorant Garamond", Georgia, serif;
  }

  .avatar-ring {
    position: relative;
  }

  .avatar-ring::before {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C8965A, #DBA86C, #6B8F71, #C8965A);
    background-size: 300% 300%;
    animation: avatarGlow 6s ease-in-out infinite;
    z-index: -1;
  }

  @keyframes avatarGlow {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .title-role {
    animation: slideInRole 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.3s both;
  }

  @keyframes slideInRole {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .about-card {
    border: 1px solid rgba(200, 150, 90, 0.1);
    border-radius: 12px;
    padding: 1.5rem;
    background: rgba(26, 24, 22, 0.4);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .about-card:hover {
    border-color: rgba(200, 150, 90, 0.25);
    background: rgba(32, 29, 26, 0.5);
    box-shadow: 0 0 24px rgba(200, 150, 90, 0.06);
  }
</style>
