---
import { details } from "../../data/details.json";
---

<section class="fade-in-delay-1">
  <h2 class="section-title">
    Work experience
  </h2>

  <div class="card-grid">
    {
      details.map((template, i) => (
        <a
          href={template.link}
          target="_blank"
          rel="noopener noreferrer"
          class="experience-card group hud-frame"
          style={`animation-delay: ${0.1 + i * 0.08}s`}
        >
          <span class="tech-ref absolute top-1.5 right-2">LOG_{String(i + 1).padStart(3, '0')}</span>
          <div class="card-accent" />
          <div class="card-body">
            <span class="shrink-0 font-mono text-[10px] tabular-nums text-zinc-600 tracking-wider">
              {template.date}
            </span>
            <p class="mt-1 font-display text-xs font-normal tracking-wider text-zinc-200 uppercase group-hover:text-accent">
              {template.title}
              <span class="ml-1 inline-block text-zinc-600 transition-transform duration-75 group-hover:translate-x-1 group-hover:text-accent">
                ↗
              </span>
            </p>
            <p class="mt-1.5 font-mono text-xs text-zinc-500">{template.desc}</p>
            <p class="mt-1 font-mono text-[10px] text-zinc-600">
              <svg
                aria-label="Location:"
                class="location-icon"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="10"
                height="10"
              >
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
              </svg>
              {template.location}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .card-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .experience-card {
    position: relative;
    display: block;
    padding: 1rem 1.25rem;
    background: rgba(10, 10, 10, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    transition: border-color 0.05s ease, box-shadow 0.05s ease;
    text-decoration: none;
    overflow: hidden;
    animation: cardSlideIn 0.5s ease-out both;
  }

  .experience-card:hover {
    border-color: rgba(255, 63, 0, 0.5) !important;
    box-shadow: 0 0 16px rgba(255, 63, 0, 0.08);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 0;
    background: #FF3F00;
    transition: height 0.1s ease;
  }

  .experience-card:hover .card-accent {
    height: 100%;
  }

  .card-body {
    position: relative;
    z-index: 1;
  }

  .location-icon {
    display: inline-block;
    vertical-align: middle;
    margin-right: 2px;
    margin-top: -2px;
    color: currentColor;
  }

  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>