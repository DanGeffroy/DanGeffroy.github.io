---
import { details } from "../../data/details.json";

const cardColors = ["#FF6B9D", "#4DEEEA", "#FFE74C", "#06D6A0", "#C77DFF", "#FF8C42"];
---

<section class="fade-in-delay-1">
  <h2 class="section-title">
    Work experience
  </h2>

  <div class="flex flex-col gap-4">
    {
      details.map((template, i) => (
        <a
          href={template.link}
          target="_blank"
          rel="noopener noreferrer"
          class="brutal-card group relative flex overflow-hidden no-underline"
          style={`animation: cardSlideIn 0.5s ease-out both; animation-delay: ${0.1 + i * 0.08}s;`}
        >
          <div class="w-2 shrink-0" style={`background: ${cardColors[i % cardColors.length]};`} />
          <div class="py-4 px-5">
            <span class="inline-block border-2 border-ink px-[0.6rem] py-[0.2rem] text-[0.7rem] font-extrabold text-ink" style={`background: ${cardColors[i % cardColors.length]};`}>
              {template.date}
            </span>
            <p class="mt-2 text-sm font-black uppercase tracking-tight text-ink">
              {template.title}
              <span class="ml-1 inline-block transition-transform duration-150 group-hover:translate-x-1">
                ↗
              </span>
            </p>
            <p class="mt-1.5 text-xs text-ink/60">{template.desc}</p>
            <p class="mt-2 text-xs font-bold text-ink/50">
              <svg
                aria-label="Location:"
                class="mr-[3px] -mt-0.5 inline-block align-middle"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="12"
                height="12"
              >
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
              </svg>
              {template.location}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>
