---
import { details } from "../../data/details.json";
---

<section class="fade-in-delay-1">
  <h2
    class="mb-6 text-xs font-semibold uppercase tracking-wider text-zinc-500"
  >
    Work experience
  </h2>

  <div class="card-grid">
    {
      details.map((template, i) => (
        <a
          href={template.link}
          target="_blank"
          rel="noopener noreferrer"
          class="experience-card group"
          style={`animation-delay: ${0.1 + i * 0.08}s`}
        >
          <div class="card-accent" />
          <div class="card-body">
            <span class="shrink-0 text-xs tabular-nums text-zinc-600">
              {template.date}
            </span>
            <p class="mt-1 text-sm font-medium text-zinc-200 group-hover:text-white">
              {template.title}
              <span class="ml-1 inline-block text-zinc-600 transition-transform group-hover:translate-x-1">
                ↗
              </span>
            </p>
            <p class="mt-1.5 text-sm text-zinc-500">{template.desc}</p>
            <p class="mt-1 text-xs text-zinc-600">📍 {template.location}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .card-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .experience-card {
    position: relative;
    display: block;
    border: 1px solid rgba(139, 92, 246, 0.08);
    border-radius: 12px;
    padding: 1rem 1.25rem;
    background: rgba(24, 24, 27, 0.4);
    backdrop-filter: blur(8px);
    transition: all 0.3s ease;
    text-decoration: none;
    overflow: hidden;
    animation: cardSlideIn 0.5s ease-out both;
  }

  .experience-card:hover {
    border-color: rgba(139, 92, 246, 0.25);
    background: rgba(30, 30, 34, 0.6);
    box-shadow: 0 4px 24px rgba(139, 92, 246, 0.06);
    transform: translateY(-2px);
  }

  .card-accent {
    position: absolute;
    top: 0;
    left: 0;
    width: 3px;
    height: 0;
    background: linear-gradient(180deg, #8b5cf6, #a855f7);
    border-radius: 3px;
    transition: height 0.3s ease;
  }

  .experience-card:hover .card-accent {
    height: 100%;
  }

  .card-body {
    position: relative;
    z-index: 1;
  }

  @keyframes cardSlideIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

