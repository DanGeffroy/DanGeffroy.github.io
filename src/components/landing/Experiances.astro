---
import { details } from "../../data/details.json";
---

<section class="fade-in-delay-1">
  <h2
    class="mb-6 text-xs font-semibold uppercase tracking-wider text-zinc-500"
  >
    Work experience
  </h2>

  <div class="space-y-1">
    {
      details.map((template) => (
        <a
          href={template.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group -mx-3 flex flex-col gap-1 rounded-lg px-3 py-4 transition-colors hover:bg-dark-100 md:flex-row md:items-baseline md:gap-6"
        >
          <span class="shrink-0 text-xs tabular-nums text-zinc-600 md:w-24">
            {template.date}
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-zinc-200 group-hover:text-white">
              {template.title}
              <span class="ml-1 inline-block text-zinc-600 transition-transform group-hover:translate-x-0.5">
                ↗
              </span>
            </p>
            <p class="mt-0.5 text-sm text-zinc-500">{template.desc}</p>
            <p class="mt-0.5 text-xs text-zinc-600">{template.location}</p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .fade-in-delay-1 {
    animation: fadeIn 0.6s ease-out 0.15s both;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
