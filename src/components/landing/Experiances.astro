---
import { details } from "../../data/details.json";
---

<section id="experience" class="fade-in-delay-1 py-16 md:py-24">
  <!-- Section label -->
  <div class="flex items-center gap-4 mb-10">
    <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-[#f5f5f5]">
      Experience
    </h2>
    <div class="flex-1 h-px bg-[#262626]"></div>
  </div>

  <!-- Horizontal timeline container -->
  <div class="timeline-container overflow-x-auto pb-6 -mx-6 px-6 md:-mx-12 md:px-12">
    <div class="flex flex-nowrap gap-0 min-w-max">
      {
        details.map((template, i) => (
          <a
            href={template.link}
            target="_blank"
            rel="noopener noreferrer"
            class="timeline-item group relative flex-shrink-0 w-64 md:w-72 border border-[#262626] p-5 transition-all duration-300 hover:border-[#525252] hover:scale-105 hover:z-10"
            style={`animation-delay: ${0.1 + i * 0.1}s`}
          >
            {/* Connecting line */}
            {i < details.length - 1 && (
              <div class="absolute top-1/2 -right-px w-px h-6 bg-[#262626] -translate-y-1/2 z-0" />
            )}

            {/* Date */}
            <span class="block text-[11px] text-[#737373] tracking-wide mb-3">
              {template.date}
            </span>

            {/* Title */}
            <h3 class="text-sm font-bold text-[#f5f5f5] leading-snug mb-1 group-hover:text-accent transition-colors duration-300">
              {template.title}
              <span class="ml-1 inline-block text-[#737373] opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:translate-x-1 group-hover:text-accent">
                ↗
              </span>
            </h3>

            {/* Description / Company */}
            <p class="text-xs italic text-[#a3a3a3] leading-relaxed mb-2">
              {template.desc}
            </p>

            {/* Location */}
            <div class="flex items-center gap-1 text-[11px] text-[#737373]">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                width="10"
                height="10"
                class="shrink-0"
              >
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5S10.62 6.5 12 6.5s2.5 1.12 2.5 2.5S13.38 11.5 12 11.5z" />
              </svg>
              {template.location}
            </div>

            {/* Bottom timeline dot and line */}
            <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 flex flex-col items-center">
              <div class="w-2 h-2 rounded-full bg-[#262626] border border-[#525252] group-hover:bg-accent group-hover:border-accent transition-colors duration-300" />
            </div>
          </a>
        ))
      }
    </div>

    {/* Timeline base line */}
    <div class="mt-3 h-px bg-[#262626] min-w-max" style={`width: ${details.length * 18}rem`}></div>
  </div>

  <!-- Scroll hint for mobile -->
  <p class="mt-4 text-[10px] text-[#737373] uppercase tracking-[0.15em] md:hidden text-center">
    ← Swipe to explore →
  </p>
</section>

<style>
  .timeline-container {
    scrollbar-width: thin;
    scrollbar-color: #262626 transparent;
  }

  .timeline-container::-webkit-scrollbar {
    height: 4px;
  }

  .timeline-container::-webkit-scrollbar-track {
    background: transparent;
  }

  .timeline-container::-webkit-scrollbar-thumb {
    background: #262626;
    border-radius: 2px;
  }

  .timeline-item {
    animation: cardFadeIn 0.6s ease-out both;
  }

  @keyframes cardFadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>